# Supabase > Project Settings > Database > Connection string
# Pooler (Transaction, puerto 6543): lo usa la app
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432): la usan las migraciones de Prisma
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.fpsrnkwpxwfzpstlmfnf.supabase.co:5432/postgrespostgresql://postgres:[YOUR-PASSWORD]@db.fpsrnkwpxwfzpstlmfnf.supabase.co:5432/postgres"
